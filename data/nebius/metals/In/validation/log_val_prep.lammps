velocity        crystal create 429.7 2028 mom yes rot no dist gaussian
fix             prod all npt temp ${T} ${T} ${tdamp} aniso 0.0 0.0 ${pdamp}
fix             prod all npt temp 429.7 ${T} ${tdamp} aniso 0.0 0.0 ${pdamp}
fix             prod all npt temp 429.7 429.7 ${tdamp} aniso 0.0 0.0 ${pdamp}
fix             prod all npt temp 429.7 429.7 0.1 aniso 0.0 0.0 ${pdamp}
fix             prod all npt temp 429.7 429.7 0.1 aniso 0.0 0.0 1.0
thermo_style    custom step temp pe ke press vol lx ly lz ecouple
variable        st equal step
variable        tt equal temp
variable        vv equal vol
variable        lxx equal lx
variable        lyy equal ly
variable        lzz equal lz
variable        ec equal ecouple
