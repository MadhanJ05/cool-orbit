compute         dsp all displace/atom
variable        moved atom "c_dsp[4] > 1.5"
compute         nm all reduce sum v_moved
variable        fmoved equal c_nm/atoms
variable        st equal step
variable        tt equal temp
variable        pea equal pe/atoms
variable        kea equal ke/atoms
variable        vv equal vol
variable        lxx equal lx
variable        lyy equal ly
variable        lzz equal lz
variable        ec equal ecouple
thermo_style    custom step temp pe ke press vol lx ly lz v_fmoved ecouple
fix             npt all npt temp ${T} ${T} ${tdamp} ${couple} 0.0 0.0 ${pdamp}
fix             npt all npt temp 429.7 ${T} ${tdamp} ${couple} 0.0 0.0 ${pdamp}
fix             npt all npt temp 429.7 429.7 ${tdamp} ${couple} 0.0 0.0 ${pdamp}
fix             npt all npt temp 429.7 429.7 0.1 ${couple} 0.0 0.0 ${pdamp}
fix             npt all npt temp 429.7 429.7 0.1 iso 0.0 0.0 ${pdamp}
fix             npt all npt temp 429.7 429.7 0.1 iso 0.0 0.0 1.0
# Header via `print` (fix print's title is written literally, without variable substitution), then the data rows.
print           "# latent phase=${phase} T_target_K=${T} n_atoms=$(atoms) barostat=${couple} dt_ps=${dt} prod_steps=${prod} seed=${seed} | step T_K pe_per_atom_eV ke_per_atom_eV volume_A3 lx_A ly_A lz_A ecouple_eV" file h_${phase}_T${T}.dat screen no
print           "# latent phase=${phase} T_target_K=${T} n_atoms=$(atoms) barostat=${couple} dt_ps=${dt} prod_steps=${prod} seed=${seed} | step T_K pe_per_atom_eV ke_per_atom_eV volume_A3 lx_A ly_A lz_A ecouple_eV" file h_liquid_T${T}.dat screen no
print           "# latent phase=${phase} T_target_K=${T} n_atoms=$(atoms) barostat=${couple} dt_ps=${dt} prod_steps=${prod} seed=${seed} | step T_K pe_per_atom_eV ke_per_atom_eV volume_A3 lx_A ly_A lz_A ecouple_eV" file h_liquid_T429.7.dat screen no
fix             log all print ${every} "${st} ${tt} ${pea} ${kea} ${vv} ${lxx} ${lyy} ${lzz} ${ec}" append h_${phase}_T${T}.dat screen no
fix             log all print 50 "${st} ${tt} ${pea} ${kea} ${vv} ${lxx} ${lyy} ${lzz} ${ec}" append h_${phase}_T${T}.dat screen no
fix             log all print 50 "${st} ${tt} ${pea} ${kea} ${vv} ${lxx} ${lyy} ${lzz} ${ec}" append h_liquid_T${T}.dat screen no
fix             log all print 50 "${st} ${tt} ${pea} ${kea} ${vv} ${lxx} ${lyy} ${lzz} ${ec}" append h_liquid_T429.7.dat screen no
run             ${prod}
