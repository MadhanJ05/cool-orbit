LAMMPS (22 Jul 2025 - Update 4)
# Enthalpy of ONE phase at temperature T, for the latent heat (H_liquid - H_solid at the melting point).
# T must be THIS POTENTIAL's melting point, from the coexistence jobs (not the experimental value). Run twice,
# from an element folder, same T, one log per job:
#   lmp -in ../in.latent.lmp -log log_<El>-latent-solid.lammps  -var phase solid  -var T <Tm_MEAM> -var seed 2026
#   lmp -in ../in.latent.lmp -log log_<El>-latent-liquid.lammps -var phase liquid -var T <Tm_MEAM> -var seed 2026
# Like coolorbit/sim/melting.py latent mode: the liquid is the crystal box rescaled by +5% volume and melted (NVT)
# at Thot = 3 x T, then NPT at T (the barostat then finds the liquid's own density, which is HIGHER than the
# crystal's for Ga and Bi). H per atom = PE + KE (PV = 0 at P = 0).
# The SOLID runs with an ANISOTROPIC barostat: Ga, In, Sn and Bi are non-cubic, and an isotropic barostat would
# keep the starting (experimental) c/a, so the solid's enthalpy would be too high and the latent heat too low.
# Thot is 3 x T, not 1.6 x T: a perfect periodic crystal has no interface to start melting from and superheats
# (laptop validation: Ga, In and Bi did not melt at all at 1.6 x in 12 ps). MELT_CHECK reports whether it melted.
# analyze.py checks the phases stayed what they are, and flags enthalpy drift and box-shape changes.

variable        dt      index 0.002
variable        tdamp   index 0.1
variable        pdamp   index 1.0
variable        melt    index 6000
variable        prod    index 25000
variable        every   index 50
variable        expand  index 0.05
variable        Thot    index $(3.0*v_T)
variable        Thot    index 1289.0999999999999091

units           metal
atom_style      atomic
boundary        p p p
read_data       data.solid.lmp
Reading data file ...
  orthogonal box = (0 0 0) to (22.764 22.764 24.73)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  490 atoms
  read_data CPU = 0.003 seconds
include         potential.mod
# In: 2NN MEAM, NIST IPR 2008--Do-E-C--In--LAMMPS--ipr1 (doi:10.1016/j.calphad.2007.08.004). Needs the MEAM package.
pair_style meam
pair_coeff * * potential/library.meam In potential/In.meam In
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        ${dt}
timestep        0.002
thermo_style    custom step temp pe ke press vol lx ly lz ecouple
thermo          ${every}
thermo          50

if "${phase} == solid" then "variable couple string aniso" elif "${phase} == liquid" "variable couple string iso" else "print 'phase must be solid or liquid'" "quit 1"
variable couple string iso

if "${phase} == liquid" then   "change_box all x scale $((1+v_expand)^(1/3)) y scale $((1+v_expand)^(1/3)) z scale $((1+v_expand)^(1/3)) remap"   "compute dsp0 all displace/atom"   "variable moved0 atom 'c_dsp0[4] > 1.5'"   "compute nm0 all reduce sum v_moved0"   "variable fmelt equal c_nm0/atoms"   "thermo_style custom step temp pe ke press vol v_fmelt ecouple"   "velocity all create ${Thot} ${seed} mom yes rot no dist gaussian"   "fix hot all nvt temp ${Thot} ${Thot} ${tdamp}"   "run ${melt}"   "print 'MELT_CHECK liquid_prep_moved_fraction ${fmelt} (want >= 0.8: the liquid really melted at Thot)'"   "unfix hot"
change_box all x scale $((1+v_expand)^(1/3)) y scale $((1+v_expand)^(1/3)) z scale $((1+v_expand)^(1/3)) remap
change_box all x scale 1.0163963568148535188 y scale $((1+v_expand)^(1/3)) z scale $((1+v_expand)^(1/3)) remap
change_box all x scale 1.0163963568148535188 y scale 1.0163963568148535188 z scale $((1+v_expand)^(1/3)) remap
change_box all x scale 1.0163963568148535188 y scale 1.0163963568148535188 z scale 1.0163963568148535188 remap
Changing box ...
  orthogonal box = (-0.18662333 0 0) to (22.950623 22.764 24.73)
  orthogonal box = (-0.18662333 -0.18662333 0) to (22.950623 22.950623 24.73)
  orthogonal box = (-0.18662333 -0.18662333 -0.20274095) to (22.950623 22.950623 24.932741)
compute dsp0 all displace/atom
variable moved0 atom 'c_dsp0[4] > 1.5'
compute nm0 all reduce sum v_moved0
variable fmelt equal c_nm0/atoms
thermo_style custom step temp pe ke press vol v_fmelt ecouple
velocity all create ${Thot} ${seed} mom yes rot no dist gaussian
velocity all create 1289.0999999999999091 ${seed} mom yes rot no dist gaussian
velocity all create 1289.0999999999999091 2026 mom yes rot no dist gaussian
fix hot all nvt temp ${Thot} ${Thot} ${tdamp}
fix hot all nvt temp 1289.0999999999999091 ${Thot} ${tdamp}
fix hot all nvt temp 1289.0999999999999091 1289.0999999999999091 ${tdamp}
fix hot all nvt temp 1289.0999999999999091 1289.0999999999999091 0.1
run ${melt}
run 6000
