# ---- 2. alpha-Ga at T
units           metal
atom_style      atomic
boundary        p p p
read_data       stability/alpha_relaxed.lmp
Reading data file ...
  orthogonal box = (0.0082788846 0.96539123 -0.74210136) to (22.586721 22.011609 23.372101)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  600 atoms
  reading velocities ...
  600 velocities
  read_data CPU = 0.001 seconds
include         potential.mod
# Ga: 2NN MEAM, NIST IPR 2009--Do-E-C--Ga-In--LAMMPS--ipr1 (doi:10.1088/0953-8984/21/32/325801). Needs the MEAM package.
pair_style meam
pair_coeff * * potential/library.meam Ga In potential/GaIn.meam Ga
neighbor        1.0 bin
timestep        ${dt}
timestep        0.002
variable        L0x equal $(lx)
variable        L0x equal 22.578442230779764088
variable        L0y equal $(ly)
variable        L0y equal 21.046217543346255496
variable        L0z equal $(lz)
variable        L0z equal 24.114202723936347894
velocity        all create ${T} ${seed} mom yes rot no dist gaussian
velocity        all create 302.92 ${seed} mom yes rot no dist gaussian
velocity        all create 302.92 2026 mom yes rot no dist gaussian
compute         dsp all displace/atom
variable        moved atom "c_dsp[4] > 1.5"
compute         nm all reduce sum v_moved
compute         cn all coord/atom cutoff 2.6
compute         cnavg all reduce ave c_cn
compute         rdf all rdf 200 cutoff 4.0
fix             rdfout all ave/time 100 50 10000 c_rdf[*] file stability/rdf_T${T}.dat mode vector
fix             rdfout all ave/time 100 50 10000 c_rdf[*] file stability/rdf_T302.92.dat mode vector
fix             npt all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0
fix             npt all npt temp 302.92 ${T} 0.1 aniso 0.0 0.0 1.0
fix             npt all npt temp 302.92 302.92 0.1 aniso 0.0 0.0 1.0
thermo_style    custom step temp pe lx ly lz press c_cnavg ecouple
thermo          500
run             ${steps}
run             10000
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 5
  ghost atom cutoff = 5
  binsize = 2.5, bins = 10 9 10
  4 neighbor lists, perpetual/occasional/extra = 2 2 0
  (1) pair meam, perpetual
      attributes: full, newton on
      pair build: full/bin/atomonly
      stencil: full/bin/3d
      bin: standard
  (2) pair meam, perpetual, half/full from (1)
      attributes: half, newton on
      pair build: halffull/newton
      stencil: none
      bin: none
  (3) compute coord/atom, occasional, copy from (1)
      attributes: full, newton on
      pair build: copy
      stencil: none
      bin: none
  (4) compute rdf, occasional, copy from (2)
      attributes: half, newton on
      pair build: copy
      stencil: none
      bin: none
