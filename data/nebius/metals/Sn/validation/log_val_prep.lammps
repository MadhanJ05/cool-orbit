# 4. production at T ----------------------------------------------------------------------------------
velocity        crystal create ${T} $(v_seed+2) mom yes rot no dist gaussian
velocity        crystal create 505.1 $(v_seed+2) mom yes rot no dist gaussian
velocity        crystal create 505.1 2028 mom yes rot no dist gaussian
fix             prod all npt temp ${T} ${T} ${tdamp} aniso 0.0 0.0 ${pdamp}
fix             prod all npt temp 505.1 ${T} ${tdamp} aniso 0.0 0.0 ${pdamp}
fix             prod all npt temp 505.1 505.1 ${tdamp} aniso 0.0 0.0 ${pdamp}
fix             prod all npt temp 505.1 505.1 0.1 aniso 0.0 0.0 ${pdamp}
fix             prod all npt temp 505.1 505.1 0.1 aniso 0.0 0.0 1.0
thermo_style    custom step temp pe ke press vol lx ly lz ecouple
variable        st equal step
variable        tt equal temp
variable        vv equal vol
variable        lxx equal lx
variable        lyy equal ly
variable        lzz equal lz
variable        ec equal ecouple
# Header via `print` (fix print's title is written literally, without variable substitution), then the data rows.
print           "# coexistence T_target_K=${T} n_atoms=$(atoms) Tprep_K=${Tprep} Tmelt_K=${Tmelt} melt_liquid_moved=${melt_liq} melt_crystal_moved=${melt_cry} melt_liquid_T_K=${melt_tliq} dt_ps=${dt} prod_steps=${prod} seed=${seed} | step T_K pe_per_atom_eV volume_A3 lx_A ly_A lz_A ecouple_eV" file pe_T${T}.dat screen no
print           "# coexistence T_target_K=${T} n_atoms=$(atoms) Tprep_K=${Tprep} Tmelt_K=${Tmelt} melt_liquid_moved=${melt_liq} melt_crystal_moved=${melt_cry} melt_liquid_T_K=${melt_tliq} dt_ps=${dt} prod_steps=${prod} seed=${seed} | step T_K pe_per_atom_eV volume_A3 lx_A ly_A lz_A ecouple_eV" file pe_T505.1.dat screen no
fix             log all print ${every} "${st} ${tt} ${pea} ${vv} ${lxx} ${lyy} ${lzz} ${ec}" append pe_T${T}.dat screen no
fix             log all print 50 "${st} ${tt} ${pea} ${vv} ${lxx} ${lyy} ${lzz} ${ec}" append pe_T${T}.dat screen no
fix             log all print 50 "${st} ${tt} ${pea} ${vv} ${lxx} ${lyy} ${lzz} ${ec}" append pe_T505.1.dat screen no
run             ${prod}
run             400
