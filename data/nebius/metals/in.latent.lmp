# Enthalpy of ONE phase at temperature T, for the latent heat (H_liquid - H_solid at the melting point).
# Run twice from an element folder, same T:
#   lmp -in ../in.latent.lmp -var phase solid  -var T 505.1 -var seed 2026
#   lmp -in ../in.latent.lmp -var phase liquid -var T 505.1 -var seed 2026
# Like coolorbit/sim/melting.py latent mode: liquid = crystal box expanded 5% in volume and melted (NVT), then
# both phases NPT (isotropic, P = 0) at T. H per atom = PE + KE (PV = 0 at P = 0).
# The liquid is melted at Thot = 3 x T by default, NOT 1.6 x T: a perfect periodic crystal has no interface to
# start melting from and superheats (laptop validation: Ga, In and Bi crystals did not melt at all at 1.6 x the
# experimental Tm in 12 ps). The MELT_CHECK line reports whether the liquid really melted.
# T must be the melting point (use the coexistence result); analyze.py checks the phases stayed what they are.

variable        dt      index 0.002
variable        tdamp   index 0.1
variable        pdamp   index 1.0
variable        melt    index 6000
variable        prod    index 25000
variable        every   index 50
variable        expand  index 0.05
variable        Thot    index $(3.0*v_T)

units           metal
atom_style      atomic
boundary        p p p
read_data       data.solid.lmp
include         potential.mod
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        ${dt}
thermo_style    custom step temp pe ke press vol
thermo          ${every}

if "${phase} == liquid" then &
  "change_box all x scale $((1+v_expand)^(1/3)) y scale $((1+v_expand)^(1/3)) z scale $((1+v_expand)^(1/3)) remap" &
  "compute dsp0 all displace/atom" &
  "variable moved0 atom 'c_dsp0[4] > 1.5'" &
  "compute nm0 all reduce sum v_moved0" &
  "variable fmelt equal c_nm0/atoms" &
  "thermo_style custom step temp pe ke press vol v_fmelt" &
  "velocity all create ${Thot} ${seed} mom yes rot no dist gaussian" &
  "fix hot all nvt temp ${Thot} ${Thot} ${tdamp}" &
  "run ${melt}" &
  "print 'MELT_CHECK liquid_prep_moved_fraction ${fmelt} (want >= 0.8: the liquid really melted at Thot)'" &
  "unfix hot" &
elif "${phase} != solid" &
  "print 'phase must be solid or liquid'" &
  "quit 1"

velocity        all create ${T} $(v_seed+3) mom yes rot no dist gaussian
compute         dsp all displace/atom
variable        moved atom "c_dsp[4] > 1.5"
compute         nm all reduce sum v_moved
variable        fmoved equal c_nm/atoms
variable        st equal step
variable        tt equal temp
variable        pea equal pe/atoms
variable        kea equal ke/atoms
variable        vv equal vol
thermo_style    custom step temp pe ke press vol v_fmoved
fix             npt all npt temp ${T} ${T} ${tdamp} iso 0.0 0.0 ${pdamp}
fix             log all print ${every} "${st} ${tt} ${pea} ${kea} ${vv}" file h_${phase}_T${T}.dat screen no title "# latent phase=${phase} T_target_K=${T} n_atoms=$(atoms) | step T_K pe_per_atom_eV ke_per_atom_eV volume_A3"
run             ${prod}
print           "PHASE_CHECK phase=${phase} moved_fraction ${fmoved} (liquid wants >= 0.5, solid <= 0.2)"
write_data      final_${phase}_T${T}.lmp
