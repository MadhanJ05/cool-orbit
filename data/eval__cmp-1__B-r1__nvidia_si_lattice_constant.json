   "method": {
    "engine": "ASE 3.29 EquationOfState + mace-torch 0.3.15 ASE calculator (GPU, ALCHEMI toolkit environment)",
    "model": "MACE-MP-0 medium (2023-12-03-mace-128-L1_epoch-199), float64; trained on MPtrj (PBE/PBE+U)",
    "protocol": "static 0 K E(V) scan: 11 isotropic strains of the 8-atom cubic cell, a in [0.96,1.04]*a_guess; Birch-Murnaghan fit (cross-checked with Vinet/Murnaghan and spans of +-2/4/6%); a = (8*V0_per_atom)^(1/3)",
    "ensemble": null,
    "timestep_fs": null,
    "n_atoms": 8,
    "sim_length_ps": null,
    "seeds": null,
    "supercell_check_n_atoms": 64,
