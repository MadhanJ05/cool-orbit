unfix           eq

# 2. split along z; melt the upper half with the lower half frozen -------------------------------------
variable        zmid equal $(0.5*(zlo+zhi))
variable        zmid equal 27.203000000000141512
region          upper block INF INF INF INF ${zmid} INF units box
region          upper block INF INF INF INF 27.2030000000001 INF units box
group           liquid region upper
708 atoms in group liquid
group           crystal subtract all liquid
700 atoms in group crystal
compute         tliq liquid temp
compute         dsp all displace/atom
variable        moved atom "c_dsp[4] > 1.5"
compute         nml liquid reduce sum v_moved
compute         nmc crystal reduce sum v_moved
variable        fliq equal c_nml/count(liquid)
variable        fcry equal c_nmc/count(crystal)
thermo_style    custom step temp c_tliq pe ke press vol lz v_fliq v_fcry ecouple

velocity        crystal set 0.0 0.0 0.0
fix             pin crystal setforce 0.0 0.0 0.0
velocity        liquid create ${Tmelt} $(v_seed+1) mom yes rot no dist gaussian temp tliq
velocity        liquid create 1289.1 $(v_seed+1) mom yes rot no dist gaussian temp tliq
velocity        liquid create 1289.1 2027 mom yes rot no dist gaussian temp tliq
fix             hot liquid npt temp ${Tmelt} ${Tmelt} ${tdamp} z 0.0 0.0 ${pdamp} dilate liquid
fix             hot liquid npt temp 1289.1 ${Tmelt} ${tdamp} z 0.0 0.0 ${pdamp} dilate liquid
fix             hot liquid npt temp 1289.1 1289.1 ${tdamp} z 0.0 0.0 ${pdamp} dilate liquid
fix             hot liquid npt temp 1289.1 1289.1 0.1 z 0.0 0.0 ${pdamp} dilate liquid
fix             hot liquid npt temp 1289.1 1289.1 0.1 z 0.0 0.0 1.0 dilate liquid
fix_modify      hot temp tliq
WARNING: Temperature for fix modify is not for group all (src/src/fix_nh.cpp:1402)
run             ${melt}
run             6000
