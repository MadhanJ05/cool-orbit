{"type":"system","subtype":"task_notification","task_id":"b8z678dzd","run_id":"0mvx0pmco-883073c0","tool_use_id":"toolu_01AwCuCCXuhzZhniPgu9cGWB","status":"failed","output_file":"","summary":"cat > md.py <<'EOF'\nimport sys, time, numpy as np, warnings; warnings.filterwarnings(\"ignore\")\nfrom ase.build import bulk\nfrom ase import units\nfrom ase.md.langevin import Langevin\nfrom ase.md.verlet import VelocityVerlet\nfrom ase.md.velocitydistribution import MaxwellBoltzmannDistribution, Stationary\nfrom mace.calculators import mace_mp\nn=int(sys.argv[1]); tag=f\"N{2*n**3}\"\nrho=0.48  # g/cm3, approx liquid Li density near 800 K\na=(2*6.941/(rho*0.60221))**(1/3)\nat=bulk(\"Li\",\"bcc\",a=a,cubic=True).repeat((n,n,n))\nat.calc=mace_mp(model=\"medium\", device=\"cuda\", default_dtype=\"float32\", enable_cueq=True)\ndt=2.0*units.fs\nMaxwellBoltzmannDistribution(at, temperature_K=1500); Stationary(at)\nLangevin(at, dt, temperature_K=1500, friction=0.02/units.fs).run(1500)   # melt 3 ps\nlg=Langevin(at, dt, temperature_K=800, friction=0.01/units.fs)\nTs=[]; lg.attach(lambda: Ts.append(at.get_temperature()), 10); lg.run(3000)  # equilibrate 6 ps\nprint(tag,\"a\",a,\"T_equil(last 3ps)\",np.mean(Ts[-150:]),flush=True)\nStationary(at)\nvv=VelocityVerlet(at, dt)\nE=[];T=[];P=[];X=[]\ndef log():\n    ep=at.get_potential_energy(); ek=at.get_kinetic_energy()\n    E.append((ep+ek)/len(at)); T.append(at.get_temperature())\n    X.append(at.get_positions().copy())\n    if len(X)%10==0: P.append(-np.trace(at.get_stress(voigt=False))/3/units.GPa)\nvv.attach(log, 25); vv.run(int(sys.argv[2]))\nnp.savez(f\"{tag}.npz\", E=np.array(E), T=np.array(T), P=np.array(P), X=np.array(X), dt_save_ps=0.05, L=at.cell[0,0])\nprint(tag,\"done\",flush=True)\nEOF\nnohup python md.py 5 15000 > N250.log 2>&1 &\nnohup python md.py 4 15000 > N128.log 2>&1 &\nsleep 90; tail -2 N250.log N128.log","uuid":"cb5d9ef7-ac83-4bdc-96fb-ec52ba059e98","session_id":"f0cb447c-5b09-4929-b8ae-4d7feb0d135b"}
