{"type":"system","subtype":"task_notification","task_id":"b6nlyflt0","run_id":"0mvxbx8uz-c4dd7594","tool_use_id":"toolu_01RbfEAFQuc5xSt1FF8vnPy6","status":"stopped","output_file":"","summary":"cat > /work/run/ana.py <<'EOF'\nimport numpy as np\nd=np.load(\"/work/run/traj.npz\"); P=d[\"pos\"]; dt=float(d[\"dt\"]); E=d[\"E\"]; T=d[\"T\"]; N=int(d[\"N\"])\nP=P-P.mean(1,keepdims=True)  # remove COM drift\nnf=len(P); t=np.arange(nf)*dt/1000  # ps\ndef msd(P):\n    m=np.zeros(len(P)//2)\n    for lag in range(1,len(m)): m[lag]=((P[lag:]-P[:-lag])**2).sum(-1).mean()\n    return m\ndef D_of(P):\n    m=msd(P); tt=np.arange(len(m))*dt/1000; s=len(m)//4\n    k=np.polyfit(tt[s:],m[s:],1)[0]; return k/6*1e-4, m  # A2/ps -> cm2/s\nD,m=D_of(P)\nblocks=[D_of(b)[0] for b in np.array_split(P,4)]\nprint(\"D=%.3e cm2/s  blocks=\"%D, [\"%.3e\"%b for b in blocks], \"sem=%.2e\"%(np.std(blocks,ddof=1)/2))\np=np.polyfit(t,E,1)[0]; print(\"drift %.2e eV/atom/ps, total dE/atom %.2e, std E/atom %.2e\"%(p/N,(E[-1]-E[0])/N,E.std()/N))\nprint(\"T mean %.1f std %.1f, len %.2f ps, MSD end %.1f A2\"%(T.mean(),T.std(),t[-1],m[-1]))\nL=float(d[\"V\"])**(1/3); print(\"L=%.2f A, finite-size corr (Yeh-Hummer) needs viscosity; alat=%.4f\"%(L,float(d[\"alat\"])))\nEOF\ntimeout 3500 bash -c 'until grep -qE \"nve wall|Error\" /work/run/li.log; do sleep 20; done'; tail -2 /work/run/li.log; python /work/run/ana.py","uuid":"13ec87f7-9e8f-43be-a605-da3f8093c33e","session_id":"55ec492f-8869-45a9-9192-5bf72fb02a67"}
