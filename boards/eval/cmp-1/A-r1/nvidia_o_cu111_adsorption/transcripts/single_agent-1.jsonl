{"type":"system","subtype":"background_tasks_changed","tasks":[{"task_id":"bv41n4gtt","run_id":"0mvwxsumf-dc6c77ee","task_type":"local_bash","description":"mkdir -p /work/scripts && cat > /work/scripts/oc.py <<'EOF'\nimport numpy as np, warnings; warnings.filterwarnings(\"ignore\")\nfrom ase import Atoms\nfrom ase.build import bulk, fcc111, add_adsorbate\nfrom ase.optimize import BFGS\nfrom ase.filters import FrechetCellFilter\nfrom ase.constraints import FixAtoms\nfrom mace.calculators import mace_mp\ncalc = mace_mp(model=\"medium\", default_dtype=\"float64\", device=\"cuda\")\ndef E(a): a.calc=calc; return a.get_potential_energy()\n# bulk Cu\nb = bulk(\"Cu\",\"fcc\",a=3.6,cubic=True); b.calc=calc\nBFGS(FrechetCellFilter(b),logfile=None).run(fmax=1e-3)\na0 = b.cell.lengths()[0]; eb = E(b)/len(b)\nrho = 4*63.546/6.02214076e23/(a0*1e-8)**3\nprint(f\"a0={a0:.4f} A density={rho:.3f} g/cm3 Ecoh={E(Atoms('Cu',cell=[20]*3))-eb:.3f} eV\")\n# isolated atoms, O2\neO = E(Atoms(\"O\",cell=[20]*3,pbc=False))\no2 = Atoms(\"O2\",positions=[[0,0,0],[0,0,1.23]],cell=[20]*3); o2.calc=calc\nBFGS(o2,logfile=None).run(fmax=1e-3); eO2=E(o2)\nprint(f\"E(O)={eO:.4f} E(O2)={eO2:.4f} d(O2)={o2.get_distance(0,1):.3f} De(O2)={2*eO-eO2:.3f}\")\nres={}\nfor size,layers in [((3,3),4),((2,2),4),((3,3),5),((4,4),4)]:\n    s = fcc111(\"Cu\",size=(*size,layers),a=a0,vacuum=10.0)\n    s.set_constraint(FixAtoms(mask=[at.tag>2 for at in s]))\n    s.calc=calc; BFGS(s,logfile=None).run(fmax=0.01); es=E(s)\n    for site in [\"fcc\",\"hcp\",\"bridge\",\"ontop\"]:\n        sa=s.copy(); add_adsorbate(sa,\"O\",1.2 if site!=\"ontop\" else 1.8,site)\n        sa.set_constraint(FixAtoms(mask=[at.tag>2 for at in sa])); sa.calc=calc\n        BFGS(sa,logfile=None).run(fmax=0.01,steps=500); ea=E(sa)\n        # check site retained: lateral displacement of O\n        print(f\"{size} L{layers} {site:6s} Eads(O atom)={ea-es-eO:.3f}  Eads(1/2O2)={ea-es-0.5*eO2:.3f} zO={sa.positions[-1,2]-sa.positions[:-1,2].max():.2f}\", flush=True)\nEOF\ncd /work && python scripts/oc.py 2>&1 | grep -v -i warn"}],"uuid":"fb2b65c0-81c1-4c8e-a92c-24b61f3d7fef","session_id":"24387e54-a126-4a5c-9040-a5860d1c47ed"}
