{"type":"system","subtype":"background_tasks_changed","tasks":[{"task_id":"bqo6t2z3n","run_id":"0mvxi9shc-c060c00b","task_type":"local_bash","description":"ls -la ~/.cache/mace/; mkdir -p /work/run; cat > /work/run/eos.py <<'E'\nimport numpy as np, json, warnings; warnings.filterwarnings(\"ignore\")\nfrom ase.build import bulk\nfrom ase.eos import EquationOfState\nfrom mace.calculators import mace_mp\ncalc = mace_mp(model=\"/tmp/home/.cache/mace/macempa0mediummodel\", device=\"cuda\", default_dtype=\"float64\")\nsystems = {\"Si\":(\"diamond\",5.43),\"Ge\":(\"diamond\",5.66),\"C\":(\"diamond\",3.57),\"Cu\":(\"fcc\",3.61),\"Al\":(\"fcc\",4.05),\"Ag\":(\"fcc\",4.09)}\nout={}\nfor el,(cs,a0) in systems.items():\n    res={}\n    for rng,n in [(0.02,11),(0.04,11),(0.06,15)]:\n        for sc in [1,2,3]:\n            V=[];E=[]\n            for s in np.linspace(1-rng,1+rng,n):\n                at=bulk(el,cs,a=a0*s,cubic=True).repeat(sc); at.calc=calc\n                V.append(at.get_volume()/len(at)); E.append(at.get_potential_energy()/len(at))\n            for eos in [\"birchmurnaghan\",\"vinet\",\"murnaghan\"]:\n                e=EquationOfState(V,E,eos=eos); v0,e0,B=e.fit()\n                nat=8 if cs==\"diamond\" else 4\n                res[f\"{rng}_{sc}_{eos}\"]=( (v0*nat)**(1/3), B*160.21766)\n    a=np.array([r[0] for r in res.values()])\n    out[el]=dict(a_mean=a.mean(),a_min=a.min(),a_max=a.max(),B=np.mean([r[1] for r in res.values()]),details=res)\n    print(el, f\"a={a.mean():.5f} spread [{a.min():.5f},{a.max():.5f}] B={out[el]['B']:.1f} GPa\", flush=True)\njson.dump(out,open(\"/work/run/eos.json\",\"w\"),indent=1)\nE\ncd /work/run && python eos.py 2>&1 | grep -v -i warn | tail -20"}],"uuid":"90d58a4c-bfec-4b4a-a42b-6b1ec2843095","session_id":"da0dc3b6-c5de-4e9f-8234-2ef78e8ae4a4"}
