{"type":"system","subtype":"background_tasks_changed","tasks":[{"task_id":"bicvvlsgp","run_id":"0mvxiqq4v-294281e7","task_type":"local_bash","description":"mkdir -p /work/run && cat > /work/run/md.py <<'E'\nimport sys, json, time, numpy as np, warnings; warnings.filterwarnings(\"ignore\")\nfrom ase.build import bulk\nfrom ase import units\nfrom ase.md.langevin import Langevin\nfrom ase.md.nptberendsen import NPTBerendsen\nfrom ase.md.verlet import VelocityVerlet\nfrom ase.md.velocitydistribution import MaxwellBoltzmannDistribution, Stationary\nfrom mace.calculators import mace_mp\ncfg = json.loads(sys.argv[1]); tag = cfg[\"tag\"]\ncalc = mace_mp(model=\"/root/.cache/mace/macempa0mediummodel\" if False else __import__('os').path.expanduser(\"~/.cache/mace/macempa0mediummodel\"), device=\"cuda\", default_dtype=\"float32\")\na = bulk(cfg[\"el\"], cfg[\"lat\"], a=cfg[\"a\"], cubic=True).repeat(cfg[\"rep\"])\na.calc = calc; N = len(a); dt = cfg[\"dt\"]*units.fs; T = cfg[\"T\"]\nlog = open(f\"/work/run/{tag}.log\", \"w\")\ndef P(*x): print(*x, file=log, flush=True)\nP(\"N\", N, cfg)\nMaxwellBoltzmannDistribution(a, temperature_K=cfg[\"Tmelt\"]); Stationary(a)\nt0 = time.time()\nLangevin(a, dt, temperature_K=cfg[\"Tmelt\"], friction=0.02).run(int(cfg[\"melt_ps\"]*1000/cfg[\"dt\"]))\nP(\"melt done\", time.time()-t0, \"s, T=\", a.get_temperature())\n# NPT for density\nnpt = NPTBerendsen(a, dt, temperature_K=T, pressure_au=0.0, taut=100*units.fs, taup=1000*units.fs, compressibility_au=cfg[\"kappa\"]/units.GPa)\nvols = []; nsteps = int(cfg[\"npt_ps\"]*1000/cfg[\"dt\"])\nfor i in range(nsteps//20):\n    npt.run(20); vols.append(a.get_volume())\nvols = np.array(vols); h = len(vols)//2\nmass = a.get_masses().sum()*1.66054\ndens = mass/vols[h:]\nnb=5; bl=np.array_split(dens,nb); bm=[b.mean() for b in bl]\nP(\"density g/cm3 (2nd half)\", dens.mean(), \"+-\", np.std(bm,ddof=1)/np.sqrt(nb), \"T\", a.get_temperature())\njson.dump({\"dens_series\": (mass/vols).tolist()}, open(f\"/work/run/{tag}_dens.json\",\"w\"))\nif cfg.get(\"prod_ps\",0)>0:\n    V = vols[h:].mean(); a.set_cell(a.cell*(V/a.get_volume())**(1/3), scale_atoms=True)\n    Langevin(a, dt, temperature_K=T, friction=0.02).run(int(cfg[\"eq_ps\"]*1000/cfg[\"dt\"]))\n    MaxwellBoltzmannDistribution(a, temperature_K=T); Stationary(a)\n    dyn = VelocityVerlet(a, dt); ev = cfg[\"every\"]; n = int(cfg[\"prod_ps\"]*1000/cfg[\"dt\"])//ev\n    pos = []; Ts=[]; Es=[]\n    prev = a.get_positions().copy(); un = prev.copy(); cell = a.cell.lengths()\n    for i in range(n):\n        dyn.run(ev); p = a.get_positions(); d = p-prev; d -= cell*np.round(d/cell); un = un+d; prev=p.copy()\n        pos.append(un.copy()); Ts.append(a.get_temperature()); Es.append(a.get_total_energy())\n    np.save(f\"/work/run/{tag}_traj.npy\", np.array(pos, dtype=np.float32))\n    P(\"prod done\", time.time()-t0, \"T mean\", np.mean(Ts), \"std\", np.std(Ts), \"Edrift eV/atom\", (Es[-1]-Es[0])/N, \"L\", cell[0], \"dt_frame_fs\", ev*cfg[\"dt\"])\nE\ncd /work/run && timeout 300 python md.py '{\"tag\":\"speed\",\"el\":\"Li\",\"lat\":\"bcc\",\"a\":3.51,\"rep\":6,\"Tmelt\":1500,\"T\":800,\"melt_ps\":0.2,\"npt_ps\":0.2,\"kappa\":0.08,\"dt\":1.0}' 2>/dev/null; cat speed.log"}],"uuid":"5cca6746-9ed8-456a-99be-13e60133f3c9","session_id":"cdf79a2a-b9ca-4d2e-afd7-856fe2f24685"}
