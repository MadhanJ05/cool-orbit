{"type":"system","subtype":"task_notification","task_id":"b8emh3wav","run_id":"0mvxig9rw-172e1b26","tool_use_id":"toolu_01PcgVY2A7p9nHg7wCppDo4A","status":"completed","output_file":"","summary":"mkdir -p /work/run && cat > /work/run/ads.py <<'EOF'\nimport numpy as np, warnings; warnings.filterwarnings(\"ignore\")\nfrom ase import Atoms\nfrom ase.build import fcc111, add_adsorbate, bulk\nfrom ase.optimize import BFGS\nfrom ase.constraints import FixAtoms\nfrom ase.filters import ExpCellFilter\nfrom mace.calculators import mace_mp\nimport glob\nmp=glob.glob('/tmp/home/.cache/mace/macempa0mediummodel*')[0]\ncalc=mace_mp(model=mp, device='cuda', default_dtype='float64')\ndef E(a): a.calc=calc; return a.get_potential_energy()\n# bulk Cu\nb=bulk('Cu','fcc',a=3.61,cubic=True); b.calc=calc\nBFGS(ExpCellFilter(b),logfile=None).run(fmax=1e-4)\na0=b.cell[0,0]; print('a0',a0,'Ecoh/atom (vs MLIP atom)',E(Atoms('Cu',cell=[20]*3))-b.get_potential_energy()/4)\n# O atom, O2\nEO=E(Atoms('O',positions=[[0,0,0]],cell=[20,20,20]))\no2=Atoms('O2',positions=[[10,10,10],[10,10,11.21]],cell=[20,20,20]); o2.calc=calc\nBFGS(o2,logfile=None).run(fmax=1e-4)\nEO2=o2.get_potential_energy(); print('EO',EO,'EO2',EO2,'dO2',o2.get_distance(0,1),'De(O2)',2*EO-EO2)\nres={}\nfor size,nl in [((3,3,4),2),((4,4,4),2),((3,3,5),3),((2,2,4),2)]:\n    s=fcc111('Cu',size=size,a=a0,vacuum=8.0,periodic=True)\n    nfix=size[0]*size[1]*nl\n    s.set_constraint(FixAtoms(indices=[at.index for at in s if at.tag>size[2]-nl]))\n    s.calc=calc; BFGS(s,logfile=None).run(fmax=0.005); Es=s.get_potential_energy()\n    for site in ['fcc','hcp','ontop','bridge']:\n        x=s.copy(); add_adsorbate(x,'O',1.2 if site!='ontop' else 1.8,site); x.calc=calc\n        BFGS(x,logfile=None).run(fmax=0.005,steps=500)\n        Ex=x.get_potential_energy(); z=x.positions[-1,2]-x.positions[:-1,2].max()\n        print(size,site,'Eads_atom %.3f  Eads_halfO2 %.3f  h %.2f'%(Ex-Es-EO, Ex-Es-EO2/2, z),flush=True)\nEOF\ncd /work/run && python ads.py 2>&1 | grep -v -iE \"warn|torch|cueq|^\\s*$\" | tail -30","uuid":"20aa773a-8716-40d9-8eeb-356582ec7833","session_id":"9ff4257f-dc55-405d-ab5f-d44e109352e9"}
