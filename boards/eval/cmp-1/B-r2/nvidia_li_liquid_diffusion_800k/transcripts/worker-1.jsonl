_atoms=True)\nLangevin(atoms,dt,temperature_K=T,friction=0.01).run(3000)\nStationary(atoms)\ndyn=VelocityVerlet(atoms,dt)\npos=[];temps=[];etot=[]\nnstep=int(prod_ps*1000); every=10\ndef rec():\n    pos.append(atoms.get_positions(wrap=False).copy()); temps.append(atoms.get_temperature()); etot.append(atoms.get_total_energy())\nrec()\nfor i in range(nstep//every):\n    dyn.run(every); rec()\npos=np.array(pos); np.save(f'/work/run/{tag}_pos.npy',pos)\nout.update(n_atoms=len(atoms),L=float(atoms.cell[0,0]),T_mean=float(np.mean(temps)),T_std=float(np.std(temps)),\n  Edrift_meV_atom_ps=float((etot[-1]-etot[0])/len(atoms)/prod_ps*1000),prod_ps=prod_ps,wall=time.time()-t0)\njson.dump(out,open(f'/work/run/{tag}.json','w'),indent=1); print(out)\nEOF\ncd /work/run && timeout 120 python md.py 2 800 test 0.2 2>&1 | grep -v Warn | tail -5\" completed (exit code 0)","uuid":"6808113f-9c6b-42f6-bf62-15e1495b1887","session_id":"7a3ee98b-7002-4283-82d0-8dda5402a44f"}
